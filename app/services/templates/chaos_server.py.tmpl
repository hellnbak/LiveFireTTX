def same_local_origin(request, origin):
    try:
        candidate = urlsplit(origin)
        request_origin = urlsplit(
            f"{request.url.scheme}://{request.headers.get('host', '')}"
        )
        candidate_port = candidate.port or 80
        request_port = request_origin.port or 80
    except ValueError:
        return False
    return bool(
        candidate.scheme == request.url.scheme == "http"
        and candidate.hostname in APPROVED_HOSTS
        and request_origin.hostname in APPROVED_HOSTS
        and candidate_port == request_port
        and candidate.username is None
        and candidate.password is None
        and candidate.path in {"", "/"}
        and not candidate.query
        and not candidate.fragment
    )


@app.middleware("http")
async def protect_mutations(request: Request, call_next):
    origin = request.headers.get("origin")
    fetch_site = request.headers.get("sec-fetch-site", "").lower()
    opaque_same_origin = origin == "null" and fetch_site == "same-origin"
    if request.method in MUTATING_METHODS and (
        (
            origin is not None
            and not opaque_same_origin
            and not same_local_origin(request, origin)
        )
        or (origin is None and fetch_site == "cross-site")
    ):
        return JSONResponse(
            {"detail": "Cross-origin state changes are not allowed"},
            status_code=403,
        )
    return await call_next(request)


class ActionRequest(BaseModel):
    intensity: str = "medium"
    pattern: str = "steady"
    seed: Optional[int] = None
    duration_seconds: int = Field(default=300, ge=15, le=3600)
    max_latency_ms: int = Field(default=5000, ge=100, le=10000)
    max_error_rate: float = Field(default=0.5, ge=0, le=1)
    abort_on_target_unreachable: bool = True


@app.get("/health")
def health():
    state = get_state()
    target = target_snapshot()
    active_playbooks = [
        run
        for run in state["playbook_runs"]
        if run["status"] in {"running", "paused"}
    ]
    return {
        "healthy": True,
        "ready": target["reachable"] and target["matches_exercise"],
        "exercise_id": EXERCISE_ID,
        "revision": state["revision"],
        "active_runs": len(state["active_actions"]),
        "active_playbooks": len(active_playbooks),
        "target": target,
    }


@app.get("/ready")
def ready():
    snapshot = target_snapshot()
    is_ready = snapshot["reachable"] and snapshot["matches_exercise"]
    return JSONResponse(
        {
            "ready": is_ready,
            "exercise_id": EXERCISE_ID,
            "target": snapshot,
        },
        status_code=200 if is_ready else 503,
    )


