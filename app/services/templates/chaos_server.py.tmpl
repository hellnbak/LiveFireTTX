EXERCISE_ID = "__EXERCISE_ID__"
TARGET_URL = os.environ.get("LIVEFIRE_TARGET_URL", "http://livefire-target:8088")
LOGGER = logging.getLogger("livefire.chaos")
APPROVED_HOSTS = {
    "127.0.0.1",
    "localhost",
    "::1",
    "host.docker.internal",
    "testserver",
}
MUTATING_METHODS = {"POST", "PUT", "PATCH", "DELETE"}


def target_resource(path):
    try:
        with urllib.request.urlopen(f"{TARGET_URL}{path}", timeout=1) as response:
            return json.loads(response.read())
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise HTTPException(
            status_code=503,
            detail=f"Target resource unavailable: {exc}",
        ) from exc


def target_snapshot():
    started = time.monotonic()
    try:
        with urllib.request.urlopen(f"{TARGET_URL}/health", timeout=1) as response:
            payload = json.loads(response.read())
        return {
            "reachable": True,
            "matches_exercise": payload.get("exercise_id") == EXERCISE_ID,
            "response_time_ms": round((time.monotonic() - started) * 1000, 2),
            **payload,
        }
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        return {
            "reachable": False,
            "matches_exercise": False,
            "response_time_ms": round((time.monotonic() - started) * 1000, 2),
            "error": str(exc),
        }


def guardrail_violation(active, snapshot):
    stop_conditions = active.get("stop_conditions", {})
    if not snapshot.get("reachable"):
        if stop_conditions.get("abort_on_target_unreachable", True):
            return "target_unreachable"
        return None
    if not snapshot.get("matches_exercise"):
        return "target_exercise_mismatch"
    conditions = snapshot.get("conditions", {})
    if conditions.get("latency_ms", 0) > stop_conditions.get(
        "max_latency_ms",
        5000,
    ):
        return "latency_threshold_exceeded"
    if conditions.get("error_rate", 0) > stop_conditions.get(
        "max_error_rate",
        0.5,
    ):
        return "error_rate_threshold_exceeded"
    return None


def require_target_preflight():
    snapshot = target_snapshot()
    if not snapshot["reachable"] or not snapshot["matches_exercise"]:
        raise HTTPException(
            status_code=503,
            detail="Target preflight failed for this exercise",
        )
    return snapshot


def fail_action_run(run_id, action, reason, snapshot=None):
    state = get_state()
    run = next((item for item in state["runs"] if item["id"] == run_id), None)
    if not run:
        return
    if run["status"] == "pending":
        fail_run(run_id, reason, snapshot)
    elif run["status"] == "active":
        abort(action, reason)


def orchestrate_due_stages():
    for due in due_playbook_stages():
        playbook_run_id = due["playbook_run_id"]
        stage_id = due["stage_id"]
        stage = due["stage"]
        claimed = False
        action_run_id = None
        snapshot = None
        try:
            stage = claim_playbook_stage(playbook_run_id, stage_id)
            claimed = True
            snapshot = target_snapshot()
            if not snapshot["reachable"] or not snapshot["matches_exercise"]:
                fail_playbook_stage(
                    playbook_run_id,
                    stage_id,
                    "target_preflight_failed",
                )
                continue

            pending = begin_run(
                stage["action"],
                stage["intensity"],
                stage["duration_seconds"],
                stage["stop_conditions"],
                pattern=stage["pattern"],
                seed=due["seed"],
                playbook_run_id=playbook_run_id,
                stage_id=stage_id,
            )
            action_run_id = pending["id"]
            activate_run(action_run_id, snapshot)
            link_playbook_stage(playbook_run_id, stage_id, action_run_id)
            observe_run(action_run_id, "after_apply", target_snapshot())
        except ValueError as exc:
            if action_run_id:
                fail_action_run(
                    action_run_id,
                    stage["action"],
                    f"playbook_stage_failed:{exc}",
                    snapshot,
                )
            if claimed:
                fail_playbook_stage(playbook_run_id, stage_id, str(exc))
            LOGGER.warning(
                "Unable to start playbook stage %s/%s: %s",
                playbook_run_id,
                stage_id,
                exc,
            )


async def monitor_runs():
    while True:
        await asyncio.sleep(1)
        try:
            update_patterns()
            orchestrate_due_stages()
            state = get_state()
            if state["active_actions"]:
                snapshot = target_snapshot()
                for action, active in list(state["active_actions"].items()):
                    violation = guardrail_violation(active, snapshot)
                    observe_run(active["run_id"], "guardrail_check", snapshot)
                    if violation:
                        abort(action, f"guardrail:{violation}")
            sync_playbook_runs()
        except Exception:
            LOGGER.exception("Chaos orchestration monitor failed")


@asynccontextmanager
async def lifespan(app):
    monitor = asyncio.create_task(monitor_runs())
    try:
        yield
    finally:
        monitor.cancel()
        try:
            await monitor
        except asyncio.CancelledError:
            pass


