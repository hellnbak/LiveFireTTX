@app.put("/playbooks/{playbook_id}")
def put_playbook(
    playbook_id: str,
    playbook: dict = Body(...),
):
    if playbook.get("id") not in {None, playbook_id}:
        raise HTTPException(
            status_code=400,
            detail="Playbook path id does not match the configuration id",
        )
    playbook["id"] = playbook_id
    try:
        return save_playbook(playbook)
    except (TypeError, ValueError) as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc


@app.delete("/playbooks/{playbook_id}")
